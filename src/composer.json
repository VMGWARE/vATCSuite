{
    "name": "vmgware/vatcsuite",
    "type": "project",
    "description": "vATC Suite provides virtual air traffic controllers with essential tools like ATIS and AWOS generation to enhance realism in online flying networks.",
    "keywords": [
        "atis",
        "generator",
        "atc"
    ],
    "license": "CC BY-NC-SA 4.0",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "backpack/crud": "^7.1",
        "backpack/logmanager": "^5.1",
        "backpack/permissionmanager": "^7.3",
        "backpack/settings": "^3.2",
        "backpack/theme-coreuiv4": "^1.2",
        "backpack/theme-tabler": "^2.1",
        "guzzlehttp/guzzle": "^7.16",
        "laravel/framework": "^12.70",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "php-ffmpeg/php-ffmpeg": "^1.4",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-sitemap": "^8.2",
        "tartanlegrand/laravel-openapi": "^2.1",
        "tremby/laravel-git-version": "^1.2"
    },
    "require-dev": {
        "backpack/generators": "^4.1",
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.5",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": ["php artisan storage:link"]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "backpack": {
            "type": "composer",
            "url": "https://repo.backpackforlaravel.com/"
        }
    }
}
